 "prompt_injection": [
  {
   "id": "PI001",
   "description": "An instruction to ignore earlier instructions",
   "pattern": "(?i)\\b(?:ignore|disregard|forget)\\s+(?:all\\s+|any\\s+)?(?:of\\s+)?(?:the\\s+|your\\s+)?(?:previous|prior|above|earlier|preceding)\\s+(?:instructions|prompts|rules|directions)\\b",
   "source": "https://genai.owasp.org/llmrisk/llm01-prompt-injection/"
  },
  {
   "id": "PI002",
   "description": "An instruction to hide what the agent does from the user",
   "pattern": "(?i)\\b(?:do\\s+not|don't|never)\\s+(?:tell|inform|mention|reveal|disclose|alert|notify)\\s+(?:this\\s+|it\\s+|anything\\s+)?(?:to\\s+)?the\\s+user\\b",
   "source": "https://www.pillar.security/blog/new-vulnerability-in-github-copilot-and-cursor-how-hackers-can-weaponize-code-agents"
  },
  {
   "id": "PI003",
   "description": "Invisible Unicode tag characters, which can carry instructions a reviewer cannot see",
   "pattern": "[\\U000E0000-\\U000E007F]",
   "source": "https://www.pillar.security/blog/new-vulnerability-in-github-copilot-and-cursor-how-hackers-can-weaponize-code-agents"
  },
  {
   "id": "PI004",
   "description": "Bidirectional control characters, which can hide or reorder text in an editor",
   "pattern": "[\\u202A-\\u202E\\u2066-\\u2069]",
   "source": "https://www.pillar.security/blog/new-vulnerability-in-github-copilot-and-cursor-how-hackers-can-weaponize-code-agents"
  }
