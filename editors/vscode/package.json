{
  "name": "vibeaudit",
  "displayName": "vibeaudit",
  "description": "Security and quality findings for AI-built and LLM apps, with one-click fixes, from the vibeaudit language server.",
  "version": "0.16.2",
  "publisher": "Ashin06",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ashin-06/vibeaudit"
  },
  "homepage": "https://github.com/Ashin-06/vibeaudit#readme",
  "bugs": {
    "url": "https://github.com/Ashin-06/vibeaudit/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "security",
    "linter",
    "static analysis",
    "llm",
    "ai",
    "vibe coding",
    "sast",
    "code review"
  ],
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:go",
    "onLanguage:java",
    "onLanguage:kotlin",
    "onLanguage:csharp",
    "onLanguage:rust",
    "onLanguage:php",
    "onLanguage:ruby",
    "onLanguage:dart",
    "onLanguage:swift",
    "onLanguage:elixir",
    "workspaceContains:**/package.json",
    "workspaceContains:**/pyproject.toml",
    "workspaceContains:**/requirements.txt",
    "workspaceContains:**/go.mod",
    "workspaceContains:**/pom.xml",
    "workspaceContains:**/build.gradle",
    "workspaceContains:**/build.gradle.kts",
    "workspaceContains:**/*.csproj",
    "workspaceContains:**/Cargo.toml",
    "workspaceContains:**/composer.json",
    "workspaceContains:**/Gemfile",
    "workspaceContains:**/pubspec.yaml",
    "workspaceContains:**/Package.swift",
    "workspaceContains:**/mix.exs"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "vibeaudit starts a local program to scan the workspace, so it only runs in trusted workspaces."
    }
  },
  "contributes": {
    "configuration": {
      "title": "vibeaudit",
      "properties": {
        "vibeaudit.serverCommand": {
          "type": "string",
          "default": "vibeaudit",
          "scope": "machine",
          "description": "The vibeaudit executable (or a Python interpreter, with serverArgs [\"-m\", \"vibeaudit\", \"lsp\"])."
        },
        "vibeaudit.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "scope": "machine",
          "description": "Arguments that start the language server."
        }
      }
    },
    "commands": [
      {
        "command": "vibeaudit.restart",
        "title": "vibeaudit: Restart language server"
      }
    ]
  },
  "scripts": {
    "bundle": "esbuild extension.js --bundle --platform=node --format=cjs --target=node20 --external:vscode --minify --outfile=dist/extension.js",
    "vscode:prepublish": "npm run bundle",
    "package": "vsce package --out vibeaudit.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.25.12"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
